--- !u!114 &1165576251
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1165576248}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1213583e7199bac468f1112672de67de, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - text: Emergency detected. Stay calm and follow my instructions.
    clip: {fileID: 8300000, guid: fc6ee2b4af687c9438e97e933c7c032b, type: 3}
  - text: Follow me towards Exit B.
    clip: {fileID: 8300000, guid: c5eaa79339cc53f4faeddf0b7ece32f5, type: 3}
  - text: Exit A is blocked by fire. Turn left and follow me towards Exit B.
    clip: {fileID: 8300000, guid: 4d7e72b02fd8c9142b36e6f5f19321a0, type: 3}
  - text: Exit A is blocked. Do not approach the fire.
    clip: {fileID: 8300000, guid: eeca86c266dffd54cbb59e978d1ec06b, type: 3}
  - text: The elevator is unavailable. Do not use it during this emergency.
    clip: {fileID: 8300000, guid: 9ef5224125fe2874a9e84f1462d39ad1, type: 3}
  - text: These stairs are not a way out. Stay in the corridor.
    clip: {fileID: 8300000, guid: cbd696fe620646241bfeefbc19beb2d5, type: 3}
  - text: Stay away from the restricted classroom and laboratory.
    clip: {fileID: 8300000, guid: a5f2866351f7e7f44ba3eaa480a3251e, type: 3}
  - text: Exit B is clear. Go through the doors.
    clip: {fileID: 8300000, guid: 3766573da8cd0c5439bf633ac1e0ccd8, type: 3}
  - text: Well done. Keep going to the assembly point.
    clip: {fileID: 8300000, guid: be167ab4edbedd245a79329823a93e0b, type: 3}
  - text: Keep moving along the marked evacuation route.
    clip: {fileID: 8300000, guid: ad7228bf3ce327d448b3b2fb5ddf036c, type: 3}
  - text: You have reached the assembly point. Please remain here.
    clip: {fileID: 8300000, guid: 8e9129a7ec5ab5242aac1b1fc5803a1d, type: 3}
  - text: Stay with me. This way please.
    clip: {fileID: 8300000, guid: 75741e589454304499abf5097afd5b99, type: 3}
  - text: Come back to the corridor and follow me towards Exit B.
    clip: {fileID: 8300000, guid: b14179b8de8905a4bb6da2e3bcf8025f, type: 3}
